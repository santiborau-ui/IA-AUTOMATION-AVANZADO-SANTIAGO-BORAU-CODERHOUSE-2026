    {
      "parameters": {
        "jsCode": "// Prepara el despacho según quién validó la respuesta (controlador, o persona con botón Aprobar / Editar).\nconst d = $input.first().json;\nconst modos = {\n  aceptada:        { ruta: 'ACEPTAR',          asunto: 'Re: tu consulta - Clínica Predio AFA',                 estado: 'borrador_creado' },\n  aprobada_humano: { ruta: 'ESCALAR_APROBADO', asunto: 'Re: tu consulta - Clínica Predio AFA (aprobada)',      estado: 'borrador_creado' },\n  edicion_manual:  { ruta: 'ESCALAR_EDICION',  asunto: 'Re: tu consulta - Clínica Predio AFA (para editar)',   estado: 'borrador_para_editar' }\n};\nconst m = modos[d.modo] || modos.edicion_manual;\nconst limpia = String(d.respuesta_agente || '').trim();\nreturn [{ json: {\n  ...d,\n  ruta_final_registrada: m.ruta,\n  asunto_borrador: m.asunto,\n  cuerpo_borrador: limpia,\n  estado_despacho: m.estado,\n  canal: 'Gmail (borrador)',\n  fecha: new Date().toISOString(),\n  pregunta: d.mensaje,\n  respuesta_final: limpia,\n  fuentes_citadas: (d.fuentes_citadas || []).join(' | '),\n  costo_usd: Number(d.costo_acumulado || d.costo_usd || 0)\n} }];\n"
      },
      "id": "dp-0002",
      "name": "Preparar_Despacho",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
