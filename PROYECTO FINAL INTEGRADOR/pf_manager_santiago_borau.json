      "parameters": {
        "jsCode": "// Lee la petición del webhook (GET ?mensaje=...&session_id=...&id=...) y arma el caso con su código único.\nconst q = $input.first().json.query || {};\nconst mensaje = String(q.mensaje || '').trim().slice(0, 600);\nconst session_id = String(q.session_id || 'anonimo').replace(/[^A-Za-z0-9_-]/g, '').slice(0, 40) || 'anonimo';\nconst idCliente = String(q.id || '').replace(/[^A-Za-z0-9_-]/g, '').slice(0, 60);\n// Clave de idempotencia: el id que manda el cliente; si no manda, sesión + mensaje + ventana de 5 minutos.\nlet clave;\nif (idCliente) clave = 'id-' + idCliente;\nelse {\n  let h = 5381; const s = (session_id + '|' + mensaje.toLowerCase());\n  for (let i = 0; i < s.length; i++) h = ((h * 33) ^ s.charCodeAt(i)) >>> 0;\n  clave = 'h-' + h.toString(36) + '-' + Math.floor(Date.now() / 300000);\n}\nreturn [{ json: {\n  traceId: 'F-' + Date.now(),\n  clave_idempotencia: clave,\n  session_id, mensaje,\n  valido: mensaje.length > 0,\n  fecha_recepcion: new Date().toISOString(),\n  intentos: 0, critica_previa: '', respuesta_previa: '', resumen_previo: '', costo_acumulado: 0\n} }];\n"
      },
