    {
      "parameters": {
        "jsCode": "// Rama de error: arma el aviso para el equipo humano con el paso que falló y el código del caso.\nconst pasos = [\n  ['Airtable_Buscar_Duplicado', 'el libro de recepción (Airtable)'],\n  ['Airtable_Registrar_Recepcion', 'el libro de recepción (Airtable)'],\n  ['Execute_Worker_Memoria', 'la memoria de la conversación'],\n  ['Execute_Worker_Agente_RAG', 'el asistente que consulta el manual'],\n  ['Execute_Worker_Juez', 'el controlador de calidad'],\n  ['Execute_Worker_Despacho', 'el despacho (borrador de Gmail y registro en el CRM)']\n];\nlet falla = 'un paso del sistema';\nfor (const [n, d] of pasos) { try { if ($(n).isExecuted) falla = d; } catch (e) {} }\nconst e = $input.first().json || {};\nconst motivo = String((e.error && (e.error.message || e.error)) || e.message || 'sin detalle').slice(0, 300);\nconst base = $('Preparar_Solicitud').first().json;\nconst asunto = 'ALERTA - consulta sin responder (caso ' + base.traceId + ')';\nconst cuerpo = [\n  'Una consulta de un paciente no pudo completarse porque falló ' + falla + '.',\n  '',\n  'Código de caso: ' + base.traceId,\n  'Qué pasó: ' + motivo,\n  'Estado: la consulta quedó registrada como error y el paciente todavía no recibió respuesta.',\n  '',\n  'Qué hacer: una persona debe responder esta consulta a mano, o volver a enviarla cuando el servicio se recupere. '\n  + 'El sistema no duplica registros ni envíos, así que reenviar es seguro.'\n].join('\\n');\nreturn [{ json: { ...base, estado: 'error', ruta_final: 'ERROR', resultado: 'Falla en ' + falla + ': ' + motivo, asunto, cuerpo } }];\n"
      },
