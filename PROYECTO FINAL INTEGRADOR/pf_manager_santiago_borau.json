        "jsCode": "// Si la misma petición ya se completó (o sigue en proceso hace menos de 15 minutos) no se vuelve a procesar.\n// Una petición con estado 'error' sí se puede reintentar.\nconst base = $('Preparar_Solicitud').first().json;\nconst filas = $input.all().map(i => (i.json.fields || i.json));\nconst ahora = Date.now();\nconst dup = filas.some(f => {\n  if (!f || !f.estado) return false;\n  if (f.estado === 'completado') return true;\n  if (f.estado === 'en_proceso') {\n    const t = Date.parse(f.fecha_recepcion || '');\n    return isNaN(t) ? true : (ahora - t) < 15 * 60 * 1000;\n  }\n  return false;\n});\nreturn [{ json: { ...base, es_duplicado: dup } }];\n"
      },
