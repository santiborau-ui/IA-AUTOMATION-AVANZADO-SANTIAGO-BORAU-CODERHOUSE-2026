    {
      "parameters": {
        "jsCode": "// Lee la memoria persistente de la sesión (si existe). Si no existe, devuelve memoria vacía.\nconst filas = $input.all().map(i => (i.json.fields || i.json)).filter(f => f && f.Session_ID);\nconst f = filas[0];\nreturn [{ json: {\n  status: 'ok',\n  existe: !!f,\n  resumen_previo: f ? String(f['Resumen Consolidado'] || '') : '',\n  cantidad_mensajes: f ? Number(f['Cantidad_Mensajes'] || 0) : 0\n} }];\n"
      },
      "id": "f3fd6373-3a48-4b58-a6df-6a5115434f1c",
      "name": "Armar_Memoria_Leida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "// Arma la memoria actualizada: resumen acumulado de las últimas consultas (nunca el texto crudo completo).\nconst d = $('Execute_Workflow_Trigger').first().json;\nconst previo = String(d.resumen_previo || '');\nconst resp = String(d.respuesta_final || d.respuesta_agente || '').replace(/\\s+/g, ' ').slice(0, 220);\nconst linea = '[' + new Date().toISOString().slice(0, 10) + '] Consulta: ' + String(d.mensaje || '').replace(/\\s+/g, ' ').slice(0, 160) + ' | Respuesta: ' + resp;\nlet resumen = (previo ? previo + '\\n' : '') + linea;\nif (resumen.length > 1400) resumen = resumen.slice(resumen.length - 1400);\nconst ruta = String(d.ruta_final_registrada || d.ruta_final || '');\nconst estado = ruta.startsWith('ESCALAR') ? 'Escalado a supervisor humano' : 'Consulta administrativa';\nconst datos = JSON.stringify({ ultima_consulta: String(d.mensaje || '').slice(0, 120), ultima_ruta: ruta, ultimo_traceId: d.traceId });\nreturn [{ json: {\n  session_id: d.session_id,\n  resumen_consolidado_final: resumen,\n  estado_caso_actual: estado,\n  datos_clave_final: datos,\n  nuevo_contador: Number(d.cantidad_mensajes_previa || 0) + 1\n} }];\n"
      },
